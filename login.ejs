<!DOCTYPE html>
<html>
<head>
    <title>Znvc Rat | Login</title>
    <style>
        body { background: #050505; color: #fff; font-family: 'Segoe UI', sans-serif; margin: 0; height: 100vh; display: flex; align-items: center; justify-content: center; overflow: hidden; cursor: crosshair; }
        .card { z-index: 10; background:rgba(20, 20, 30, 0.6); backdrop-filter: blur(20px); padding: 50px; border-radius: 25px; border: 1px solid #bf00ff; text-align: center; box-shadow: 0 0 50px rgba(191, 0, 255, 0.2); }
        h1 { font-size: 4rem; color: #fff; text-shadow: 0 0 20px #bf00ff; margin-bottom: 30px; }
        a { display: inline-block; padding: 15px 40px; background: #5865F2; color: white; text-decoration: none; border-radius: 12px; transition: 0.4s; font-weight: bold; }
        a:hover { transform: scale(1.1); box-shadow: 0 0 30px #5865F2; }
        .particle { position: absolute; background: #bf00ff; border-radius: 50%; pointer-events: none; opacity: 1; }
        .footer { position: absolute; bottom: 20px; color: #666; font-size: 0.8rem; }
    </style>
</head>
<body>
    <div class="card">
        <h1>Znvc Rat</h1>
        <a href="/login">Login with Discord</a>
    </div>
    <div class="footer">Made by znvc</div>
    <script>
        function createParticle(x, y, isClick) {
            const p = document.createElement('div');
            p.className = 'particle';
            const size = Math.random() * 8 + 2;
            p.style.width = p.style.height = size + 'px';
            p.style.left = x + 'px';
            p.style.top = y + 'px';
            document.body.appendChild(p);

            const angle = Math.random() * Math.PI * 2;
            const velocity = isClick ? 15 : 2;
            const dx = Math.cos(angle) * velocity;
            const dy = Math.sin(angle) * velocity;

            let life = 1;
            function animate() {
                life -= 0.02;
                p.style.left = parseFloat(p.style.left) + dx + 'px';
                p.style.top = parseFloat(p.style.top) + dy + 'px';
                p.style.opacity = life;
                if (life > 0) requestAnimationFrame(animate);
                else p.remove();
            }
            animate();
        }
        document.addEventListener('mousemove', (e) => createParticle(e.clientX, e.clientY, false));
        document.addEventListener('click', (e) => {
            for(let i=0; i<20; i++) createParticle(e.clientX, e.clientY, true);
        });
    </script>
</body>
</html>